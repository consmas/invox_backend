DATABASE_URL=postgresql://invoix:secret@localhost:5432/invoix_development
# Production: DATABASE_URL uses the restricted role (db/roles/runtime-role.sql); migrations use the owner.
MIGRATION_DATABASE_URL=
# PEM contents of the managed database CA certificate (enables verify-full without a file).
DATABASE_CA_CERT=
# Header your trusted edge sets with the client IP, e.g. do-connecting-ip on DigitalOcean App Platform.
CLIENT_IP_HEADER=
APP_URL=http://localhost:3000
PORT=3001

# Used only by npm run db:seed-admin. No default privileged credentials are shipped.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Required for invitations and password recovery in production.
# Development without SMTP returns a preview_url in the API response.
SMTP_URL=
MAIL_FROM=Invoix <no-reply@example.com>

# Server-only 32-byte hexadecimal encryption key for authenticator enrolment.
MFA_SECRET_KEY=
# Private document storage: s3 (shared, survives redeploys; DigitalOcean Spaces works) or a persistent local directory.
# Use spaces or s3 for object storage; local is a single-instance development/persistent-volume option.
DOCUMENT_STORAGE_DRIVER=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Absolute private persistent directory, used when DOCUMENT_STORAGE_DRIVER is not s3.
DOCUMENT_STORAGE_PATH=
